diff --git a/lib/mailto.ts b/lib/mailto.ts
new file mode 100644
index 0000000..9dd5c2a
--- /dev/null
+++ b/lib/mailto.ts
@@ -0,0 +1,9 @@
+export const CONTACT_EMAIL = "Contact@printityourway.com";
+
+// Some mail clients truncate long mailto: URLs, so the body is capped.
+const MAX_BODY = 1500;
+
+export function buildMailto({ subject, body }: { subject: string; body: string }): string {
+  const trimmed = body.length > MAX_BODY ? `${body.slice(0, MAX_BODY - 1)}…` : body;
+  return `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(trimmed)}`;
+}
